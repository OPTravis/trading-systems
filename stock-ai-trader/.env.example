# ==============================================================
# stock-ai-trader Environment Variables
# Copy this file to .env and fill in your actual API keys
# ==============================================================

# --- IBKR (Interactive Brokers) ---
IBKR_USER=your_ibkr_username
IBKR_PASS=your_ibkr_password
CPG_ACCOUNT_ID=                     # Optional: CPG proxy account (live mode)

# --- Alpaca (Backup Broker) ---
ALPACA_KEY=your_alpaca_api_key
ALPACA_SECRET=your_alpaca_secret_key

# --- Financial Data APIs ---
ALPHAVANTAGE_KEY=your_alphavantage_key
FMP_KEY=your_fmp_api_key
FRED_KEY=your_fred_api_key

# --- News ---
NEWSAPI_KEY=your_newsapi_key

# --- LLM APIs ---
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
XIAOMI_API_KEY=your_xiaomi_api_key
XIAOMI_BASE_URL=https://api.xiaomi.com/v1

# --- Notifications (Feishu IM API - preferred) ---
FEISHU_APP_ID=cli_                      # Feishu App ID (cli_xxxxxxxx)
FEISHU_APP_SECRET=                       # Feishu App Secret
FEISHU_CHAT_ID=                          # Feishu Group Chat ID
# Fallback: old webhook (deprecated, use IM API above)
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
