# ==============================================================
# crypto-ai-trader Environment Variables
# Copy this file to .env and fill in your actual API keys
# ==============================================================

# --- Binance API (SPOT only - no futures/leverage) ---
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# --- LLM APIs ---
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key          # fallback LLM
XIAOMI_API_KEY=                              # optional: Xiaomi LLM

# --- Notifications (Feishu IM API - preferred) ---
FEISHU_APP_ID=cli_                          # Feishu App ID (cli_xxxxxxxx)
FEISHU_APP_SECRET=                           # Feishu App Secret
FEISHU_CHAT_ID=                              # Feishu Group Chat ID
# Fallback: old webhook (deprecated, use IM API above)
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# --- Trading Mode ---
AUTO_EXECUTE=false                           # true = auto trade, false = dry-run
USE_CCXT=0                                   # 1 = use ccxt, 0 = use python-binance SDK
